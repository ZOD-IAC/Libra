{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "types": [
      "jest"
    ],
    "skipLibCheck": true
  },
  "include": [
    "app/**/*.tsx",
    "src/**/*.ts",
    "src/**/*.tsx",
    "tests/**/*.tsx"
  ],
  "exclude": [
    "node_modules"
  ]
}
