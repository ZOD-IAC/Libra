{
  "name": "verdant",
  "version": "1.1.0",
  "description": "An offline, configuration-driven native routine tracker.",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "prebuild:android": "expo prebuild --platform android",
    "typecheck": "tsc --noEmit",
    "test:core": "node --import tsx --test tests/*.test.ts",
    "test:ui": "node scripts/check-test-deps.cjs && jest --runInBand",
    "test": "npm run test:core && npm run test:ui",
    "schema": "node --import tsx scripts/generate-schema.ts",
    "check:schema": "node --import tsx scripts/generate-schema.ts --check",
    "check": "npm run check:runtime && npm run typecheck && npm test && npm run check:schema",
    "bundle:android": "expo export --platform android --output-dir dist",
    "doctor": "npx expo-doctor",
    "check:runtime": "node scripts/check-runtime-deps.cjs"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "@expo/vector-icons": "^15.0.2",
    "@js-temporal/polyfill": "^0.5.1",
    "@react-native-community/datetimepicker": "9.2.1",
    "expo": "^58.0.23",
    "expo-constants": "~58.0.15",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.16",
    "expo-notifications": "~58.1.8",
    "expo-router": "~58.0.30",
    "expo-sharing": "~58.0.22",
    "expo-splash-screen": "~58.0.13",
    "expo-sqlite": "~58.0.15",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-gifted-charts": "^1.4.81",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.88.1",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.3.0",
    "jest": "^30.5.2",
    "jest-expo": "^58.0.14",
    "prettier": "^3.9.10",
    "test-renderer": "1.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "private": true,
  "engines": {
    "node": ">=26.13.0 <27",
    "npm": ">=12.2.2 <13"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ZOD-IAC/Libra.git"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@parcel/watcher@2.6.0": true
  },
  "packageManager": "npm@12.2.2"
}
