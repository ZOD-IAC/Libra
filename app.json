{
  "expo": {
    "name": "Verdant",
    "slug": "verdant-routine",
    "version": "1.1.0",
    "scheme": "verdant",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "android": {
      "package": "app.verdant.routine",
      "versionCode": 2,
      "allowBackup": false,
      "permissions": [
        "POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_EXACT_ALARM"
      ]
    },
    "ios": {
      "bundleIdentifier": "app.verdant.routine",
      "supportsTablet": true
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "color": "#235C45"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5F3EB",
          "image": "./assets/icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-sharing",
        {
          "android": {
            "enabled": true,
            "singleShareMimeTypes": [
              "application/json",
              "text/plain",
              "application/octet-stream"
            ]
          },
          "ios": {
            "enabled": false
          }
        }
      ],
      "./plugins/withLocalRelease.cjs"
    ],
    "updates": {
      "enabled": false
    },
    "experiments": {
      "typedRoutes": false
    }
  }
}
